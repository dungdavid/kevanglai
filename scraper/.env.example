# URL of the deployed web app (use the dev URL while testing)
API_BASE=https://your-app-dev.vercel.app
# Must equal INGEST_SECRET configured on Vercel
INGEST_SECRET=change-me-to-a-long-random-string

# Crawl settings
MAX_GROUPS_PER_RUN=8        # groups crawled per run (keep low to avoid Facebook checkpoints)
SCROLLS_PER_GROUP=6         # how far down each group feed to scroll
WATCH_INTERVAL_MINUTES=30   # interval for `npm run watch`
HEADLESS=false              # true = no browser window (higher checkpoint risk)
