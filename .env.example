# Supabase (Project Settings → API)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret between the local scraper and /api/ingest, /api/groups
INGEST_SECRET=change-me-to-a-long-random-string

# Gemini (https://aistudio.google.com/apikey). Leave empty to use the regex extractor.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
